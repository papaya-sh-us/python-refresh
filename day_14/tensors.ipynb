    {
      "cell_type": "code",
      "source": [
        "a = torch.tensor([1.0, 2.0, 3.0])\n",
        "b = torch.tensor([4.0, 5.0, 6.0])\n",
        "\n",
        "print(\"Sum:\", a + b)\n",
        "print(\"Dot product:\", torch.dot(a, b))\n",
        "print(\"Element-wise multiply:\", a * b)\n",
        "print(\"Shape:\", a.shape)"
      ],
